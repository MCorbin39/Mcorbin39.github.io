* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  min-height: 100%;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 12px;
  color: #000;

  background-color: #071a3d;
}

.page {
  width: 100%;
  max-width: 680px;
  margin: 12px auto 60px;
  padding: 0;
}

.top-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 38px;
  margin-bottom: 9px;
}

.action-button {
  width: 121px;
  height: 41px;
  flex-shrink: 0;

  background: #ffffff;
  border: 1px solid #111;
  border-radius: 0;

  font-size: 12px;
  color: #000;
  cursor: pointer;
}

.action-button:hover {
  background: #e8e8e8;
}

.site-title {
  width: 201px;
  height: 101px;
  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;

  background: #ffffff;
  border: 1px solid #111;

  font-size: 12px;
  line-height: 15px;
}

.rankings-container {
  width: 100%;
  border: 1px solid #111;
  background: #d4af37;
}

.rankings-header {
  position: relative;
  height: 23px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #d4af37;
  border-bottom: 1px solid #111;

  font-size: 12px;
}

.collapse-icon {
  position: absolute;
  left: 4px;
  top: 4px;

  width: 9px;
  height: 9px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #777;
  background: #ddd;

  font-size: 10px;
  line-height: 8px;
}

.rankings-column-labels {
  display: grid;
  grid-template-columns: 51px 1fr 52px;
  height: 17px;

  background: #d4af37;
  border-bottom: 1px solid #111;
}

.rankings-column-labels > div {
  border-right: 1px solid #111;
}

.rankings-column-labels > div:last-child {
  border-right: none;
}

.ranking-row {
  display: grid;
  grid-template-columns: 51px 1fr 52px;
  height: 60px;

  background: #d4af37;
  border-bottom: 1px solid #111;
}

.ranking-row:last-child {
  border-bottom: none;
}

.rank,
.player-name,
.points {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;

  border-right: 1px solid #111;
}

.rank {
  font-size: 12px;
}

.player-name {
  font-size: 12px;
  color: #000;
}

.points {
  border-right: none;
  line-height: 15px;
  font-size: 12px;
}

@media (max-width: 700px) {
  .page {
    width: calc(100% - 24px);
  }

  .top-controls {
    gap: 12px;
  }

  .site-title {
    width: 190px;
  }

  .action-button {
    width: 110px;
  }
}

@media (max-width: 520px) {
  .top-controls {
    flex-wrap: wrap;
    justify-content: center;
  }

  .site-title {
    order: -1;
    width: 100%;
    max-width: 201px;
  }

  .ranking-row {
    height: 55px;
  }
}
