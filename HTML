<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Indianapolis Slippi Rankings</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <main class="page">

    <!-- Top Controls -->
    <div class="top-controls">
      <button class="action-button" id="addUserBtn">
        Add User Here
      </button>

      <div class="site-title">
        An automatic hub of Indianapolis<br />
        Melee's Online Rankings
      </div>

      <button class="action-button" id="deleteUserBtn">
        Delete User Here
      </button>
    </div>

    <!-- Rankings Table -->
    <section class="rankings-container">
      <div class="rankings-header">
        <span class="collapse-icon">−</span>
        <strong>Indianapolis Slippi Rankings</strong>
      </div>

      <div class="rankings-column-labels">
        <div></div>
        <div></div>
        <div></div>
      </div>

      <div id="rankingsList">
        <!-- Ranking rows generated by JavaScript -->
      </div>
    </section>

  </main>

  <script>
    const rankingsList = document.getElementById("rankingsList");

    for (let i = 1; i <= 15; i++) {
      const row = document.createElement("div");
      row.className = "ranking-row";

      row.innerHTML = `
        <div class="rank">#${i}</div>
        <div class="player-name">Insert Tag Here</div>
        <div class="points"># of<br />points</div>
      `;

      rankingsList.appendChild(row);
    }

    document.getElementById("addUserBtn").addEventListener("click", () => {
      alert("Add user functionality goes here.");
    });

    document.getElementById("deleteUserBtn").addEventListener("click", () => {
      alert("Delete user functionality goes here.");
    });
  </script>
</body>
</html>
